<form theme="dark" version="1.1">
  <label>Troubleshooting</label>
  <description>Break down Claude Desktop logs by level and host to spot trends, with a full event listing.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time_tok">
      <label>Time range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="host_tok" searchWhenChanged="true">
      <label>Host</label>
      <choice value="*">All hosts</choice>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <search>
        <query>| metadata type=hosts index=claude | sort host | fields host</query>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </search>
      <default>*</default>
    </input>
    <input type="multiselect" token="level_tok" searchWhenChanged="true">
      <label>Log levels</label>
      <fieldForLabel>level</fieldForLabel>
      <fieldForValue>level</fieldForValue>
      <search>
        <query>`claude_index` (sourcetype=claude:desktop:main OR sourcetype=claude:desktop:mcp OR sourcetype=claude:desktop:web OR sourcetype=claude:desktop:cowork)
| eval level=lower(coalesce(log_level, log_level_b))
| where isnotnull(level)
| stats count by level | sort - count | fields level</query>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </search>
      <valuePrefix>"</valuePrefix>
      <valueSuffix>"</valueSuffix>
      <delimiter>, </delimiter>
      <default>error,warn</default>
      <initialValue>error,warn</initialValue>
    </input>
  </fieldset>

  <!-- Base: every error/warn across main, mcp, cowork, web. Grouping uses fields the logs
       actually provide: `area` from sourcetype, and `component` as-logged. Events whose log
       line carries no [component] are left as "(none)" rather than guessed at from _raw. -->
  <search id="ts_base">
    <query>`claude_index` host=$host_tok$ (sourcetype=claude:desktop:main OR sourcetype=claude:desktop:mcp OR sourcetype=claude:desktop:web OR sourcetype=claude:desktop:cowork)
| eval level=lower(coalesce(log_level, log_level_b))
| where level IN ($level_tok$)
| eval area=case(match(sourcetype,"mcp"),"mcp", match(sourcetype,"cowork"),"cowork", match(sourcetype,"web"),"web", true(),"desktop")
| eval component=coalesce(component, mcp_server, "(none)")</query>
    <earliest>$time_tok.earliest$</earliest>
    <latest>$time_tok.latest$</latest>
  </search>

  <!-- ===================== ROW 1: KPI ===================== -->
  <row>
    <panel>
      <title>Errors</title>
      <single>
        <search base="ts_base">
          <query>| where level="error" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[0,10]</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Warnings</title>
      <single>
        <search base="ts_base">
          <query>| where level="warn" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xf8be34"]</option>
        <option name="rangeValues">[0]</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Affected hosts</title>
      <single>
        <search base="ts_base">
          <query>| stats dc(host)</query>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>MCP disconnects</title>
      <single>
        <search base="ts_base">
          <query>| where match(_raw, "Server disconnected") | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[0,3]</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Distinct components</title>
      <single>
        <search base="ts_base">
          <query>| where component!="(none)" | stats dc(component)</query>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <!-- ===================== ROW 2: TRENDS / SHARES ===================== -->
  <row>
    <panel>
      <title>Events over time by level</title>
      <chart>
        <search base="ts_base">
          <query>| timechart span=1h count by level</query>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Events by component</title>
      <chart>
        <search base="ts_base">
          <query>| stats count by component | sort - count | head 10</query>
        </search>
        <option name="charting.chart">pie</option>
      </chart>
    </panel>
    <panel>
      <title>Events by host and level</title>
      <chart>
        <search base="ts_base">
          <query>| chart count over host by level</query>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
  </row>

  <!-- ===================== ROW 3: DETAIL TABLES ===================== -->
  <row>
    <panel>
      <title>Top messages (matching selected log levels) — message truncated to 160 chars</title>
      <table>
        <search base="ts_base">
          <query>| eval msg=replace(replace(replace(_raw, "\s+", " "), "^\S+ \S+ ", ""), "^(\[[^\]]+\]\s*)+", "")
| eval msg=substr(msg, 1, 160)
| stats count as events max(_time) as _epoch by host component msg
| eval last_seen=strftime(_epoch, "%Y/%m/%d %H:%M:%S")
| sort - events | head 30
| table host component msg events last_seen _epoch</query>
        </search>
        <option name="drilldown">row</option>
        <option name="wrap">true</option>
        <!-- Click a row to open that host's events in a +/-5min window around the row's time. -->
        <drilldown>
          <eval token="d_earliest">floor($row._epoch$)-300</eval>
          <eval token="d_latest">floor($row._epoch$)+300</eval>
          <link target="_blank"><![CDATA[/app/search/search?q=search `claude_index` host%3D$row.host|s$&earliest=$d_earliest$&latest=$d_latest$]]></link>
        </drilldown>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Recent events — detail truncated to 300 chars</title>
      <table>
        <search base="ts_base">
          <query>| eval detail=replace(replace(replace(_raw, "\s+", " "), "^\S+ \S+ ", ""), "^(\[[^\]]+\]\s*)+", "")
| eval detail=substr(detail, 1, 300)
| eval _epoch=_time
| table _time host area level component detail _epoch
| sort - _time | head 100</query>
        </search>
        <option name="count">25</option>
        <option name="drilldown">row</option>
        <option name="wrap">true</option>
        <!-- Click a row to open that host's events in a +/-5min window around the row's time. -->
        <drilldown>
          <eval token="d_earliest">floor($row._epoch$)-300</eval>
          <eval token="d_latest">floor($row._epoch$)+300</eval>
          <link target="_blank"><![CDATA[/app/search/search?q=search `claude_index` host%3D$row.host|s$&earliest=$d_earliest$&latest=$d_latest$]]></link>
        </drilldown>
      </table>
    </panel>
  </row>
</form>