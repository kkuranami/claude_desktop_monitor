<form theme="dark" version="1.1">
  <label>MCP</label>
  <description>This dashboard tracks the activity of Claude Desktop&#39;s MCP servers.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time_tok">
      <label>Time range</label>
      <default>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="server_tok" searchWhenChanged="true">
      <label>MCP server</label>
      <choice value="*">All</choice>
      <fieldForLabel>mcp_server</fieldForLabel>
      <fieldForValue>mcp_server</fieldForValue>
      <search>
        <query>`claude_index` host=$host_tok$ `claude_sourcetype_mcp`
| rex field=_raw "^\S+Z \[\w+\]\s+\[(?&lt;mcp_server&gt;[^\]]+)\]"
| rex field=_raw "^\S+Z \[(?&lt;mcp_server2&gt;[^\]]+)\]\s+\[\w+\]"
| eval mcp_server=coalesce(mcp_server, mcp_server2, mcp_server_from_source)
| where isnotnull(mcp_server)
| stats count by mcp_server | sort mcp_server</query>
        <earliest>$time_tok.earliest$</earliest>
        <latest>$time_tok.latest$</latest>
      </search>
      <default>*</default>
    </input>
    <input type="dropdown" token="host_tok" searchWhenChanged="true">
      <label>Host</label>
      <choice value="*">All hosts</choice>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <search>
        <query>| metadata type=hosts index=claude | sort host | fields host</query>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </search>
      <default>*</default>
    </input>
  </fieldset>

  <!-- Normalized base: one row per raw line, with server and level resolved regardless of field order. -->
  <search id="mcp_base">
    <query>`claude_index` host=$host_tok$ `claude_sourcetype_mcp`
| rex field=_raw "^\S+Z \[(?&lt;lead&gt;[^\]]+)\]\s+\[(?&lt;second&gt;[^\]]+)\]"
| eval is_lead_level=if(match(lead, "^(info|warn|warning|error|debug)$"), 1, 0)
| eval mcp_server=coalesce(if(is_lead_level=1, second, lead), mcp_server_from_source)
| eval level=lower(coalesce(if(is_lead_level=1, lead, second), "info"))
| where ("$server_tok$"="*" OR mcp_server=$server_tok|s$)</query>
    <earliest>$time_tok.earliest$</earliest>
    <latest>$time_tok.latest$</latest>
  </search>

  <!-- Tool calls: bucket client-request lines per (server, rpc_id, hour) because rpc_id is reused across sessions. -->
  <search id="mcp_calls">
    <query>`claude_index` host=$host_tok$ `claude_sourcetype_mcp` "Message from client" "method=\"tools/call\""
| rex field=_raw "\[(?&lt;mcp_server&gt;[a-z0-9-]+)\]"
| rex field=_raw "id=(?&lt;rpc_id&gt;\d+)"
| where ("$server_tok$"="*" OR mcp_server=$server_tok|s$)
| bucket _time span=1h
| stats count by mcp_server rpc_id _time</query>
    <earliest>$time_tok.earliest$</earliest>
    <latest>$time_tok.latest$</latest>
  </search>

  <row>
    <panel>
      <title>MCP servers</title>
      <single>
        <search base="mcp_base">
          <query>| where isnotnull(mcp_server) | stats dc(mcp_server)</query>
        </search>
      </single>
    </panel>
    <panel>
      <title>Tool calls</title>
      <single>
        <search base="mcp_calls">
          <query>| stats count</query>
        </search>
      </single>
    </panel>
    <panel>
      <title>Errors</title>
      <single>
        <search base="mcp_base">
          <query>| where level="error" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
      </single>
    </panel>
    <panel>
      <title>Server disconnects</title>
      <single>
        <search base="mcp_base">
          <query>| where match(_raw, "Server disconnected") | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[0,3]</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Tool calls over time</title>
      <chart>
        <search base="mcp_calls">
          <query>| timechart span=1d count as tool_calls</query>
        </search>
        <option name="charting.chart">column</option>
      </chart>
    </panel>
    <panel>
      <title>Tool calls by server</title>
      <chart>
        <search base="mcp_calls">
          <query>| stats count by mcp_server | sort - count</query>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>MCP errors by message</title>
      <table>
        <search base="mcp_base">
          <query>| where level="error"
| rex field=_raw "\]\s+(?&lt;emsg&gt;(Server disconnected|spawn \S+ \S+|[A-Z][^{]{0,80}))"
| eval emsg=trim(emsg)
| stats count as errors max(_time) as last_seen by mcp_server emsg
| sort - errors</query>
        </search>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Recent MCP log events</title>
      <table>
        <search base="mcp_base">
          <query>| eval detail=substr(replace(_raw, "^\S+Z\s+(\[[^\]]+\]\s+){2}", ""), 1, 220)
| table _time level mcp_server detail
| sort - _time | head 100</query>
        </search>
        <option name="count">100</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</form>