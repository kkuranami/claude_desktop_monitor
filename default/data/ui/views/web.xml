<form theme="dark" version="1.1">
  <label>Web</label>
  <description>This dashboard shows logs from Claude Desktop&#39;s web layer, so you can analyze tool usage and approvals along with error and warning counts.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time_tok">
      <label>Time range</label>
      <default>
        <earliest>-7d@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="host_tok" searchWhenChanged="true">
      <label>Host</label>
      <choice value="*">All hosts</choice>
      <fieldForLabel>host</fieldForLabel>
      <fieldForValue>host</fieldForValue>
      <search>
        <query>| metadata type=hosts index=claude | sort host | fields host</query>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </search>
      <default>*</default>
    </input>
  </fieldset>

  <search id="web_base">
    <query>`claude_index` host=$host_tok$ `claude_sourcetype_web`
| eval level=lower(log_level)</query>
    <earliest>$time_tok.earliest$</earliest>
    <latest>$time_tok.latest$</latest>
  </search>

  <row>
    <panel>
      <title>Tool approvals</title>
      <single>
        <search base="web_base">
          <query>| where match(_raw, "tool_approval_gate") | stats count</query>
        </search>
      </single>
    </panel>
    <panel>
      <title>Distinct tools used</title>
      <single>
        <search base="web_base">
          <query>| where isnotnull(tool_name) | stats dc(tool_name)</query>
        </search>
      </single>
    </panel>
    <panel>
      <title>Errors</title>
      <single>
        <search base="web_base">
          <query>| where level="error" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
      </single>
    </panel>
    <panel>
      <title>Warnings</title>
      <single>
        <search base="web_base">
          <query>| where level="warn" | stats count</query>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x53a051","0xf8be34"]</option>
        <option name="rangeValues">[0]</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Tool usage (from approval gate)</title>
      <chart>
        <search base="web_base">
          <query>| where isnotnull(tool_name) | stats count by tool_name | sort - count</query>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
    <panel>
      <title>Warning signals by type</title>
      <chart>
        <search base="web_base">
          <query>| where level="warn"
| eval signal=case(
    match(_raw, "MaxListenersExceededWarning"), "event_emitter_leak",
    match(_raw, "tool_approval_gate"), "tool_approval",
    match(_raw, "Deprecated API"), "deprecated_api",
    match(_raw, "ProseMirror"), "prosemirror_css",
    match(_raw, "Content Security Policy"), "csp_violation",
    true(), "other")
| stats count by signal | sort - count</query>
        </search>
        <option name="charting.chart">bar</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Renderer events over time</title>
      <chart>
        <search base="web_base">
          <query>| timechart span=1h count by level</query>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Recent tool approvals</title>
      <table>
        <search base="web_base">
          <query>| where match(_raw, "tool_approval_gate")
| rex field=_raw "\"approvalRequired\":(?&lt;approval_required&gt;true|false)"
| table _time tool_name approval_required
| sort - _time | head 50</query>
        </search>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
      </table>
    </panel>
    <panel>
      <title>Recent errors and warnings</title>
      <table>
        <search base="web_base">
          <query>| where level="error" OR level="warn"
| eval detail=substr(replace(_raw, "^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2} ", ""), 1, 200)
| table _time level component detail
| sort - _time | head 50</query>
        </search>
        <option name="count">50</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</form>